{
  "name": "dsh-skill-catalog-cache",
  "version": "0.1.1",
  "description": "Shared watched skill catalogs and bounded discovery for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "tests",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "presets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-fs": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-alpha.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-skill-catalog-cache.git"
  },
  "license": "MIT"
}
